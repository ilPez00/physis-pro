# Physis Pro API Service Configuration
# Railway variables will override these at deployment

# Billing Configuration
PHYSIS_API_Billing=true
PHYSIS_API_KEYS='{"sk_live_physis_starter": {"tier": "starter", "jobs_monthly": 100}}'

# Database (Railway will provide this via RAILWAY_PG_CONNECTION_URL)
# For local development, set your PostgreSQL connection string
# RAILWAY_PG_CONNECTION_URL=postgres://postgres:password@localhost:5432/physis

# Domain Configuration
PHYSIS_API_Domain=praxisweb.xyz

# API Configuration
PHYSIS_API_TRIAL_JOBS=100
PHYSIS_API_Currency=USD
PHYSIS_API_Support_Email=support@praxisweb.xyz

# Optional: Stripe integration (for subscription plans)
# STRIPE_Secret_Key=sk_test_XXX
# STRIPE_Public_Key=pk_test_XXX

# Optional: Monitoring
# PHYSIS_Metrics_Endpoint=https://api.datadoghq.com/api/v2/metrics

# Logging
PHYSIS_LOG_LEVEL=info
