{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:physis:semantic-computer:v1",
  "title": "Physis semantic computer contracts v1",
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "enum": [
            "exists",
            "revision_equals",
            "fact_equals",
            "authorized"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "object_id",
        "predicate",
        "value"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "physis.capability.v1"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1
        },
        "argument_schema": {
          "type": "object"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "validator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cost": {
          "type": "object",
          "properties": {
            "latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "monetary": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "latency_ms",
            "monetary"
          ],
          "additionalProperties": false
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reliability": {
          "type": "object",
          "properties": {
            "validated_successes": {
              "type": "integer",
              "minimum": 0
            },
            "validated_failures": {
              "type": "integer",
              "minimum": 0
            },
            "context_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "validated_successes",
            "validated_failures",
            "context_key"
          ],
          "additionalProperties": false
        },
        "idempotent": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "capability_id",
        "version",
        "adapter_id",
        "argument_schema",
        "preconditions",
        "expected_effects",
        "validator_ids",
        "cost",
        "risk",
        "reliability",
        "idempotent"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "physis.event.v1"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "input": {},
        "output": {},
        "state_before": {
          "type": "string",
          "minLength": 1
        },
        "state_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "properties": {
            "event_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "raw_ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "event_ids",
            "raw_ref",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "event_id",
        "recorded_at",
        "occurred_at",
        "source",
        "actor",
        "object_id",
        "operation",
        "run_id",
        "input",
        "output",
        "state_before",
        "state_after",
        "provenance"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_version": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "bound_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "state_revision": {
          "type": "string",
          "minLength": 1
        },
        "requires_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorization_ref": {
          "type": "string",
          "minLength": 1
        },
        "repair_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "step_id",
        "capability_id",
        "capability_version",
        "arguments",
        "bound_object_ids",
        "state_revision",
        "requires_steps",
        "authorization_ref",
        "repair_limit"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "physis.plan.v1"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "object"
        },
        "snapshot_revision": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "proposed",
            "authorized",
            "executing",
            "completed",
            "failed",
            "blocked"
          ]
        }
      },
      "required": [
        "schema",
        "plan_id",
        "intent",
        "goal",
        "snapshot_revision",
        "steps",
        "status"
      ],
      "additionalProperties": false
    },
    "benchmark_result": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "physis.benchmark-result.v1"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "arm": {
          "enum": [
            "raw_tools",
            "dense",
            "bm25",
            "graph",
            "physis_hybrid",
            "ablation"
          ]
        },
        "ablation": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_mode": {
          "enum": [
            "simulated",
            "dry_run",
            "real_local",
            "real_remote",
            "real_physical"
          ]
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "blocked",
            "not_measured"
          ]
        },
        "corpus_revision": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retrieved_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "graph_path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "validator_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "failed",
                  "unknown",
                  "not_run"
                ]
              },
              "evidence_event_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "validator_id",
              "status",
              "evidence_event_ids"
            ],
            "additionalProperties": false
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "number",
              "minimum": 0
            },
            "output_tokens": {
              "type": "number",
              "minimum": 0
            },
            "model_calls": {
              "type": "number",
              "minimum": 0
            },
            "latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "execution_steps": {
              "type": "number",
              "minimum": 0
            },
            "structure_build_ms": {
              "type": "number",
              "minimum": 0
            },
            "structure_update_ms": {
              "type": "number",
              "minimum": 0
            },
            "stale_context_errors": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens",
            "model_calls",
            "latency_ms",
            "execution_steps",
            "structure_build_ms",
            "structure_update_ms",
            "stale_context_errors"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "task_id",
        "pair_id",
        "arm",
        "ablation",
        "execution_mode",
        "status",
        "corpus_revision",
        "model_id",
        "run_id",
        "event_ids",
        "retrieved_object_ids",
        "selected_capability_ids",
        "graph_path",
        "validations",
        "metrics",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "validations": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    },
                    "evidence_event_ids": {
                      "minItems": 1
                    }
                  }
                }
              },
              "event_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/capability"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/benchmark_result"
    }
  ]
}
