# physis-pro-web runtime env (example — NO real values; set secrets in the
# platform, e.g. `railway variables --service physis --set "KEY=..."`).

# ── Bind / security ──────────────────────────────────────────────────────────
PHYSIS_HOST=127.0.0.1          # 0.0.0.0 in prod (then PHYSIS_API_TOKEN is REQUIRED)
PHYSIS_PORT=19876
PHYSIS_API_TOKEN=              # Bearer for protected routes (required on non-loopback bind)

# ── Embedder / models ────────────────────────────────────────────────────────
# MODEL_BASE_URL=             # pull ONNX weights from your bucket at boot
# PHYSIS_EMBEDDER=random-projection   # fast-start, skip ONNX (non-semantic!)

# ── LLM re-ranker (Phase 6G) ─────────────────────────────────────────────────
PHYSIS_RERANK=                # set 1 to enable LLM re-rank of ambiguous /classify cells
PHYSIS_RERANK_MARGIN=0.05     # top-2 score gap below which re-rank fires
# Provider keys read by ProviderCascade::from_env (priority order). Set >=1; the
# re-ranker uses the first available. (Per-request BYOK `llm_key` also works.)
AI_GEMINI_KEY=                # priority 1 — gemini-2.5-flash (default Google endpoint)
AI_GROQ_KEY=                  # priority 2 — llama-3.3-70b-versatile
AI_OPENROUTER_KEY=
# AI_DEEPSEEK_KEY=
# OPENAI_API_KEY=
# EP_GEMINI=                  # ONLY if your gemini key targets a custom/proxy endpoint
